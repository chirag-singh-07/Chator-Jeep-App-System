{
  "expo": {
    "name": "Chatori Jeeb Delivery App",
    "slug": "delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-icon-1024x1024.png",
    "scheme": "deliveryapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.chatorijeeb.deliveryapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "UIBackgroundModes": [
        "location",
        "location"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow location access to share live rider position during active deliveries.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow location access to keep rider tracking accurate during delivery, even when the app is in the background.",
        "NSCameraUsageDescription": "Allow camera access to capture live photos for document verification.",
        "NSPhotoLibraryUsageDescription": "Allow photo library access to upload documents and images.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyC4UEJcxgqwDxo1CRy4Lpy9zH7GnqN4lwg"
      }
    },
    "android": {
      "package": "com.chatorijeeb.delivery",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "statusBar": {
        "backgroundColor": "#000000",
        "barStyle": "light-content"
      },
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icons/android-icon-512x512.png",
        "dark": {
          "backgroundColor": "#000000",
          "foregroundImage": "./assets/icons/android-icon-512x512.png"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC4UEJcxgqwDxo1CRy4Lpy9zH7GnqN4lwg"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow location access to keep rider tracking accurate during delivery, even when the app is in the background."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./assets/audios/order_incoming_sound.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/ios-icon-1024x1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/icons/ios-icon-1024x1024.png"
          }
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-audio",
      "./plugins/with16kbPageSize.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ae182122-b1da-4e91-8543-cc862a389404"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ae182122-b1da-4e91-8543-cc862a389404"
    }
  }
}
