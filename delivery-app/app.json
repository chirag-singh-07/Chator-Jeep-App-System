{
  "expo": {
    "name": "Chatori Jeeb Delivery App",
    "slug": "delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-icon-1024x1024.png",
    "scheme": "deliveryapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.chatorijeeb.deliveryapp",
      "supportsTablet": true,
      "UIBackgroundModes": [
        "location"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow location access to share live rider position during active deliveries.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow location access to keep rider tracking accurate during delivery, even when the app is in the background.",
        "NSCameraUsageDescription": "Allow camera access to capture live photos for document verification.",
        "NSPhotoLibraryUsageDescription": "Allow photo library access to upload documents and images."
      }
    },
    "android": {
      "package": "com.chatorijeeb.delivery",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "statusBar": {
        "backgroundColor": "#000000",
        "barStyle": "light-content"
      },
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icons/android-icon-512x512.png",
        "dark": {
          "backgroundColor": "#000000",
          "foregroundImage": "./assets/icons/android-icon-512x512.png"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/ios-icon-1024x1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/icons/ios-icon-1024x1024.png"
          }
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "kotlinVersion": "1.9.25",
            "usesCleartextTraffic": true,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ae182122-b1da-4e91-8543-cc862a389404"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ae182122-b1da-4e91-8543-cc862a389404"
    }
  }
}