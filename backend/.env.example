NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/food_order_system
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_REQUIRED=false
JWT_ACCESS_SECRET=your_access_secret_at_least_16_chars
JWT_REFRESH_SECRET=your_refresh_secret_at_least_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*
ADMIN_NAME="Chatori Jeep Admin"
ADMIN_EMAIL="admin@chatorijeep.com"
ADMIN_PASSWORD="YourStrongPassword123!"
ADMIN_PHONE="9876543210"

# ── Backend Configuration ────────────────────────────────────────────────────────
BACKEND_URL=https://api.chatorijeeb.com

# ── Razorpay ────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_ACCOUNT_NUMBER=1234567890             # For payouts (X account)

# ── Firebase Admin SDK ──────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
